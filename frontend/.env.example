# Copy to apps/<app>/.env.local. Never commit real values.
# Server-only base URL of the EEMP API (the browser never calls it directly; the Next BFF does).
EEMP_API_BASE_URL=http://localhost:5080/api/v1
# Set to "true" to run against the in-process mock backend (no .NET API needed).
EEMP_API_MOCK=false
# Mock-mode only: password accepted for every seeded mock user. Not a real credential.
EEMP_MOCK_PASSWORD=
# Force Secure cookies even outside production (e.g. behind TLS in staging).
EEMP_COOKIE_SECURE=
# Refresh-token cookie lifetime in seconds (should match backend refresh token lifetime).
EEMP_REFRESH_COOKIE_MAX_AGE=1209600
