{
  "name": "eemp-frontend",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:mock": "pnpm --parallel --filter \"./apps/*\" dev:mock",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c e2e-real/playwright.config.ts",
    "i18n:check": "vitest run packages/i18n"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eemp/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "intl-messageformat": "^12.2.1",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
