<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1062;CA1515;CA1031;CA2007;CA1724;CA1720;CA1819;CA1308;CA1305;CA1307;CA1309;CA1310;CA1861;CA2227;CA1002;CA1034;CA1032;CA1064;CA1812;CA1852;CA1822;CA1805;CA2000;CA1873;CA1056;CA1054;CA1055;CA2234;CA1707;CA1050;CA1304;CA1311;CA1859;CA1863;CA2201;CA1869;CA1826;CA1860;CA1825;CA1847</NoWarn>
  </PropertyGroup>
</Project>
